{
	"name": "n8n-nodes-tavio-crm",
	"version": "0.1.0",
	"description": "Nós oficiais privados do Tavio CRM para n8n",
	"license": "MIT",
	"homepage": "https://github.com/fabrica-design/n8n-nodes-tavio-crm#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"tavio",
		"crm"
	],
	"author": {
		"name": "Fábrica Design",
		"email": "fabricadesignbrand@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fabrica-design/n8n-nodes-tavio-crm.git"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"verify:package": "npm run build && node scripts/verify-package.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/credentials/**/*.js",
		"dist/nodes/**/*.js",
		"dist/nodes/**/*.json",
		"dist/nodes/**/*.png"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TavioCrmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TavioCrm/TavioCrm.node.js",
			"dist/nodes/TavioCrm/TavioCrmTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.44.1",
		"@types/node": "24.3.0",
		"@vitest/coverage-v8": "3.2.4",
		"eslint": "9.39.4",
		"n8n-workflow": "2.34.2",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
